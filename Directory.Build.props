<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(OutputType)' == 'WinExe'">win-x64</RuntimeIdentifier>
    <!-- Allows WPF / Windows-targeted projects to compile on non-Windows CI agents. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Company>Nova Hardware</Company>
    <Product>Nova Hardware</Product>
    <Copyright>© 2026 Nova Hardware</Copyright>
    <Version>0.1.0</Version>
    <NoWarn>$(NoWarn);CA1848;CA1716;CA1031;CA1805;CA1822;CA2007;CA1002;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1062;CA1515;CA1812;CA1859;CA1861;CA1724;CA1720;CA1711;CA5394;CA1001;CA1063;CA1816;CA1814;CA1819;CA1823;CA1806;CA2201;CA1854;CA1869;CA1050;CA1873</NoWarn>
  </PropertyGroup>
</Project>
