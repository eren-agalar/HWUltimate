<UserControl x:Class="HWUltimate.App.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:HWUltimate.UI.Localization;assembly=HWUltimate.UI"
             xmlns:ui="clr-namespace:HWUltimate.UI.Controls;assembly=HWUltimate.UI"
             xmlns:local="clr-namespace:HWUltimate.App.Views">
  <Grid Margin="20,2,20,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="290" /><ColumnDefinition /></Grid.ColumnDefinitions>

    <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <ui:HwuIconButton Icon="Copy" Label="{loc:Tr Hw_CopyAll}" Command="{Binding CopyAllCommand}" Style="{StaticResource Hwu.IconButton.Bordered}" Margin="0,0,6,0" />
        <ui:HwuIconButton x:Name="ExportButton" Icon="Export" Label="{loc:Tr Hw_Export}" Click="ExportButton_Click" Style="{StaticResource Hwu.IconButton.Bordered}" Margin="0,0,6,0">
          <ui:HwuIconButton.ContextMenu>
            <ContextMenu>
              <MenuItem Header="HTML (.html)" Command="{Binding ExportCommand}" CommandParameter="{x:Static local:HardwareView.HtmlFormat}" />
              <MenuItem Header="JSON (.json)" Command="{Binding ExportCommand}" CommandParameter="{x:Static local:HardwareView.JsonFormat}" />
              <MenuItem Header="Text (.txt)" Command="{Binding ExportCommand}" CommandParameter="{x:Static local:HardwareView.TextFormat}" />
            </ContextMenu>
          </ui:HwuIconButton.ContextMenu>
        </ui:HwuIconButton>
        <ui:HwuIconButton Icon="Refresh" Label="{loc:Tr Common_Refresh}" Command="{Binding RefreshCommand}" Style="{StaticResource Hwu.IconButton.Bordered}"
                           IsEnabled="{Binding IsBusy, Converter={x:Static local:InverseBool.Instance}}" />
      </StackPanel>
      <TextBlock Style="{StaticResource Text.PageTitle}" Text="{loc:Tr Nav_Hardware}" VerticalAlignment="Center" />
      <TextBlock Style="{StaticResource Text.Small}" Text="{Binding Collected}" VerticalAlignment="Center" Margin="14,6,0,0" />
    </DockPanel>

    <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10">
      <ui:HwuSearchBox Width="420" Placeholder="{loc:Tr Hw_Search}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" AutomationProperties.Name="{loc:Tr Hw_Search}" />
      <TextBlock Style="{StaticResource Text.Small}" Text="{Binding SearchSummary}" VerticalAlignment="Center" Margin="12,0,0,0" />
      <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Brush.Good}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
    </DockPanel>
    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" IsIndeterminate="True" Height="2" VerticalAlignment="Bottom" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

    <!-- Device tree: computer › category › device -->
    <Border Grid.Row="2" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="0,4" ClipToBounds="True">
      <ListBox ItemsSource="{Binding DeviceView}" SelectedItem="{Binding SelectedDevice}" VirtualizingPanel.IsVirtualizingWhenGrouping="True" AutomationProperties.Name="{loc:Tr Nav_Hardware}">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Bd" Background="Transparent" Padding="26,3,8,3"><ContentPresenter /></Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PanelHover}" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selection}" /></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <DockPanel Margin="8,8,8,2">
                  <ui:Icon DockPanel.Dock="Left" Kind="{Binding Items[0].Icon}" Width="14" Height="14" Margin="0,0,8,0" Foreground="{DynamicResource Brush.Accent}" />
                  <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ListBox.GroupStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel>
              <Border DockPanel.Dock="Right" Padding="6,0" CornerRadius="8" Background="{DynamicResource Brush.Accent}" VerticalAlignment="Center"
                      Visibility="{Binding MatchCount, Converter={x:Static local:PositiveToVisibility.Instance}}">
                <TextBlock FontSize="11" Foreground="{DynamicResource Brush.OnAccent}" Text="{Binding MatchCount}" />
              </Border>
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center" />
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- Detail: Feature | Description table with section header bands -->
    <Grid Grid.Row="2" Grid.Column="1" Margin="10,0,0,0">
      <TextBlock Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{loc:Tr Hw_SelectDevice}"
                 Visibility="{Binding SelectedDevice, Converter={StaticResource NullToVisInv}}" />
      <Border Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" ClipToBounds="True"
              Visibility="{Binding SelectedDevice, Converter={StaticResource NullToVis}}">
        <DockPanel>
          <!-- Device title line -->
          <DockPanel DockPanel.Dock="Top" Margin="12,10,10,8">
            <ui:HwuIconButton DockPanel.Dock="Right" Icon="Copy" Label="{loc:Tr Hw_CopyDevice}" Command="{Binding CopyDeviceCommand}" Style="{StaticResource Hwu.IconButton.Bordered}" VerticalAlignment="Center" />
            <ui:Icon DockPanel.Dock="Left" Kind="{Binding SelectedDevice.Icon}" Width="22" Height="22" Margin="0,0,10,0" Foreground="{DynamicResource Brush.Accent}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding SelectedDevice.Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Style="{StaticResource Text.Small}"><Run Text="{Binding SelectedDevice.CategoryTitle, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding SelectedDevice.Counts, Mode=OneWay}" /></TextBlock>
            </StackPanel>
          </DockPanel>
          <!-- Legend -->
          <WrapPanel DockPanel.Dock="Top" Margin="12,0,10,8">
            <ui:HwuStatusIndicator Status="Info" Text="{loc:Tr Origin_Official}" Margin="0,0,16,0" />
            <ui:HwuStatusIndicator Status="Normal" Text="{loc:Tr Origin_Detected}" Margin="0,0,16,0" />
            <ui:HwuStatusIndicator Status="Warning" Text="{loc:Tr Origin_Live}" Margin="0,0,16,0" />
            <ui:HwuStatusIndicator Status="Inactive" Text="{loc:Tr Origin_Unavailable}" />
          </WrapPanel>
          <!-- Column header -->
          <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1">
            <Grid Height="26" Margin="0,0,14,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
              <TextBlock Margin="12,0" VerticalAlignment="Center" FontSize="{DynamicResource Size.FontSmall}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Text="{loc:Tr Hw_Feature}" />
              <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" FontSize="{DynamicResource Size.FontSmall}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Text="{loc:Tr Hw_Description}" />
              <TextBlock Grid.Column="2" Margin="8,0" VerticalAlignment="Center" FontSize="{DynamicResource Size.FontSmall}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Text="{loc:Tr Hw_Source}" />
            </Grid>
          </Border>
          <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Warnings}" Margin="12,6">
            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Style="{StaticResource Text.Small}" Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>

          <ListBox ItemsSource="{Binding DetailRows}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="{loc:Tr Hw_Description}">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Bd" Background="Transparent"><ContentPresenter /></Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PanelHover}" /></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <!-- Section header band -->
                  <Border x:Name="HeaderBand" Background="{DynamicResource Brush.RowAlt}" Padding="12,5" Visibility="Collapsed">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Header}" />
                  </Border>
                  <!-- Property row -->
                  <Grid x:Name="PropertyGrid" Visibility="Collapsed" MinHeight="24">
                    <Grid.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="{loc:Tr Explorer_CopyValue}" Command="{Binding PlacementTarget.Tag.CopyValueCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding Property}" />
                        <MenuItem Header="{loc:Tr Explorer_CopyRow}" Command="{Binding PlacementTarget.Tag.CopyPropertyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding Property}" />
                      </ContextMenu>
                    </Grid.ContextMenu>
                    <Grid.Tag><Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" /></Grid.Tag>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                    <DockPanel Margin="24,3,8,3">
                      <ui:HwuStatusIndicator x:Name="OriginDot" DockPanel.Dock="Left" Status="Normal" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="{Binding Property.Origin}" />
                      <TextBlock Text="{Binding Property.Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Grid.Column="1" Margin="8,3" VerticalAlignment="Center">
                      <TextBox x:Name="ValueText" Style="{StaticResource Text.Selectable}" Text="{Binding Property.Value, Mode=OneWay}" />
                      <TextBlock x:Name="NoteText" Style="{StaticResource Text.Small}" Text="{Binding Property.Note}" TextWrapping="Wrap" Margin="0,1,0,0" Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Style="{StaticResource Text.Small}" Text="{Binding Property.Source}" TextTrimming="CharacterEllipsis" Margin="8,3" VerticalAlignment="Center" ToolTip="{Binding Property.Source}" />
                  </Grid>
                  <!-- Live reading row -->
                  <Grid x:Name="LiveGrid" Visibility="Collapsed" MinHeight="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                    <DockPanel Margin="24,3,8,3">
                      <ui:HwuStatusIndicator DockPanel.Dock="Left" Status="Warning" Margin="0,0,8,0" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Live.Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Grid.Column="1" Margin="8,3" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular">
                      <Run Text="{Binding Live.Value, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding Live.Min, Mode=OneWay}" Foreground="{DynamicResource Brush.TextMuted}" /><Run Text=" – " Foreground="{DynamicResource Brush.TextMuted}" /><Run Text="{Binding Live.Max, Mode=OneWay}" Foreground="{DynamicResource Brush.TextMuted}" />
                    </TextBlock>
                    <TextBlock Grid.Column="2" Style="{StaticResource Text.Small}" Text="{Binding Live.Group}" Margin="8,3" VerticalAlignment="Center" />
                  </Grid>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsHeader}" Value="True"><Setter TargetName="HeaderBand" Property="Visibility" Value="Visible" /></DataTrigger>
                  <DataTrigger Binding="{Binding IsProperty}" Value="True"><Setter TargetName="PropertyGrid" Property="Visibility" Value="Visible" /></DataTrigger>
                  <DataTrigger Binding="{Binding IsLive}" Value="True"><Setter TargetName="LiveGrid" Property="Visibility" Value="Visible" /></DataTrigger>
                  <DataTrigger Binding="{Binding Property.OriginKey}" Value="Official"><Setter TargetName="OriginDot" Property="Status" Value="Info" /></DataTrigger>
                  <DataTrigger Binding="{Binding Property.IsAvailable}" Value="False">
                    <Setter TargetName="OriginDot" Property="Status" Value="Inactive" />
                    <Setter TargetName="ValueText" Property="FontStyle" Value="Italic" />
                    <Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Property.HasNote}" Value="True"><Setter TargetName="NoteText" Property="Visibility" Value="Visible" /></DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
