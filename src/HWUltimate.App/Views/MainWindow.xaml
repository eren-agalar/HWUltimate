<Window x:Class="HWUltimate.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HWUltimate.App.ViewModels"
        xmlns:v="clr-namespace:HWUltimate.App.Views"
        xmlns:loc="clr-namespace:HWUltimate.UI.Localization;assembly=HWUltimate.UI"
        xmlns:ui="clr-namespace:HWUltimate.UI.Controls;assembly=HWUltimate.UI"
        Title="HWUltimate" Width="1360" Height="860" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen" Icon="/Assets/hwultimate.ico"
        Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}" FontSize="{DynamicResource Size.Font}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:SensorExplorerViewModel}"><v:SensorExplorerView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:HardwareViewModel}"><v:HardwareView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><v:ReportsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="216" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- HwuNavigation -->
    <Border Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,16,12,22">
          <ui:HwuLogo Width="32" Height="32" AutomationProperties.Name="HWUltimate" />
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock FontFamily="{StaticResource Font.Display}" FontSize="15" FontWeight="Bold">
              <Run Text="HW" /><Run Text="ULTIMATE" Foreground="{DynamicResource Brush.Accent}" />
            </TextBlock>
            <TextBlock Text="{Binding Version, StringFormat=v{0}}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
          </StackPanel>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Margin="18,10,14,16" Text="{loc:Tr App_Tagline}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />

        <ItemsControl ItemsSource="{Binding Pages}" KeyboardNavigation.TabNavigation="Once" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <RadioButton Style="{StaticResource HwuNavigation}" GroupName="Nav" IsChecked="{Binding IsSelected, Mode=OneWay}"
                           Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Key}"
                           AutomationProperties.Name="{Binding Title}">
                <DockPanel>
                  <ui:Icon Kind="{Binding Icon}" Width="16" Height="16" Margin="0,0,12,0" />
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                </DockPanel>
              </RadioButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>

    <DockPanel Grid.Column="1">
      <!-- Title bar -->
      <Grid DockPanel.Dock="Top" Height="38">
        <TextBlock Margin="20,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" FontSize="{DynamicResource Size.FontSmall}" Text="{Binding StatusText}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource Hwu.Button.Chrome}" Click="Minimize_Click" ToolTip="{loc:Tr Window_Minimize}"><ui:Icon Kind="Minimize" Width="10" Height="10" /></Button>
          <Button Style="{StaticResource Hwu.Button.Chrome}" Click="Maximize_Click" ToolTip="{loc:Tr Window_Maximize}"><ui:Icon x:Name="MaxIcon" Kind="Maximize" Width="10" Height="10" /></Button>
          <Button Style="{StaticResource Hwu.Button.Chrome}" Click="Close_Click" ToolTip="{loc:Tr Window_Close}"><ui:Icon Kind="Close" Width="10" Height="10" /></Button>
        </StackPanel>
      </Grid>

      <!-- Elevation banner -->
      <!-- New version on GitHub -->
      <Border DockPanel.Dock="Top" Margin="20,0,20,10" Padding="12,8" CornerRadius="{StaticResource Radius.Card}"
              Background="{DynamicResource Brush.AccentSoft}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1"
              Visibility="{Binding Updates.IsBannerVisible, Converter={StaticResource BoolToVis}}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Visibility="{Binding Updates.Available, Converter={StaticResource NullToVis}}">
              <Button Style="{StaticResource Hwu.Button.Primary}" Content="{loc:Tr Update_Install}" Command="{Binding Updates.InstallCommand}" Margin="0,0,6,0" />
              <Button Content="{loc:Tr Update_WhatsNew}" Command="{Binding Updates.ShowNotesCommand}" Margin="0,0,6,0" />
              <Button Content="{loc:Tr Update_Skip}" Command="{Binding Updates.SkipCommand}" Margin="0,0,6,0" />
            </StackPanel>
            <ui:HwuIconButton Icon="Close" ToolTip="{loc:Tr Common_Close}" Command="{Binding Updates.DismissCommand}" />
          </StackPanel>
          <ui:Icon DockPanel.Dock="Left" Kind="Export" Width="16" Height="16" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0" VerticalAlignment="Center" />
          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="{Binding Updates.BannerText}" TextWrapping="Wrap" FontWeight="SemiBold" />
            <ProgressBar Height="3" Margin="0,6,0,0" Maximum="1" Value="{Binding Updates.Progress}" Visibility="{Binding Updates.IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Style="{StaticResource Text.Small}" Text="{Binding Updates.StatusText}" Visibility="{Binding Updates.IsBusy, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border DockPanel.Dock="Top" Margin="20,0,20,10" Padding="12,8" CornerRadius="{StaticResource Radius.Card}"
              Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Warn}" BorderThickness="1"
              Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisInv}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="{loc:Tr Elevation_Restart}" Command="{Binding RestartElevatedCommand}" />
          <ui:Icon Kind="Throttle" Width="16" Height="16" Foreground="{DynamicResource Brush.Warn}" Margin="0,0,10,0" />
          <TextBlock Text="{loc:Tr Elevation_Banner}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
        </DockPanel>
      </Border>

      <Grid>
        <ContentControl Content="{Binding SelectedPage.ViewModel}" Focusable="False" />

        <Border Background="{DynamicResource Brush.Background}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <ui:HwuLogo Width="72" Height="72" HorizontalAlignment="Center" />
            <TextBlock Margin="0,14,0,8" HorizontalAlignment="Center" Text="{loc:Tr Common_Loading}" />
            <ProgressBar IsIndeterminate="True" Width="200" Height="3" />
          </StackPanel>
        </Border>

      </Grid>
    </DockPanel>
  </Grid>
</Window>
