<Application x:Class="NovaHardware.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:NovaHardware.UI.Converters;assembly=NovaHardware.UI"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/NovaHardware.UI;component/Themes/Dark.xaml" />
        <ResourceDictionary Source="pack://application:,,,/NovaHardware.UI;component/Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
      <conv:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True" />
      <conv:NullToVisibilityConverter x:Key="NullToVis" />
      <conv:NullToVisibilityConverter x:Key="NullToVisInv" Invert="True" />
      <conv:QualityToBrushConverter x:Key="QualityBrush" />
      <conv:QualityToTextConverter x:Key="QualityText" />
      <conv:ThresholdToBrushConverter x:Key="ThresholdBrush" />
      <conv:EnumEqualsConverter x:Key="EnumEquals" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
