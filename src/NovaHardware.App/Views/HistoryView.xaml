<UserControl x:Class="NovaHardware.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NovaHardware.UI.Localization;assembly=NovaHardware.UI"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
  <Grid Margin="24,4,24,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
    <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
      <TextBlock Style="{StaticResource Text.PageTitle}" Text="{loc:Tr Nav_History}" Margin="0" />
      <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding DatabaseInfo}" VerticalAlignment="Center" Margin="16,6,0,0" />
    </DockPanel>

    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10">
      <DockPanel>
        <TextBox DockPanel.Dock="Top" Margin="0,0,0,8" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=200}" ToolTip="{loc:Tr Common_Search}" />
        <ListBox ItemsSource="{Binding SensorView}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                 Foreground="{DynamicResource Brush.Text}" VirtualizingPanel.IsVirtualizingWhenGrouping="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate><TextBlock Margin="4,10,0,4" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListBox.GroupStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="2">
                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" Text="{Binding Type}" Margin="8,0,0,0" />
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
          <RadioButton Style="{StaticResource Chip}" Content="{loc:Tr Hist_15m}" Command="{Binding SetRangeCommand}" CommandParameter="Hist_15m" IsChecked="{Binding RangeKey, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Hist_15m}" />
          <RadioButton Style="{StaticResource Chip}" Content="{loc:Tr Hist_1h}" Command="{Binding SetRangeCommand}" CommandParameter="Hist_1h" IsChecked="{Binding RangeKey, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Hist_1h}" />
          <RadioButton Style="{StaticResource Chip}" Content="{loc:Tr Hist_6h}" Command="{Binding SetRangeCommand}" CommandParameter="Hist_6h" IsChecked="{Binding RangeKey, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Hist_6h}" />
          <RadioButton Style="{StaticResource Chip}" Content="{loc:Tr Hist_24h}" Command="{Binding SetRangeCommand}" CommandParameter="Hist_24h" IsChecked="{Binding RangeKey, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Hist_24h}" />
          <RadioButton Style="{StaticResource Chip}" Content="{loc:Tr Hist_7d}" Command="{Binding SetRangeCommand}" CommandParameter="Hist_7d" IsChecked="{Binding RangeKey, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Hist_7d}" />
          <Button Margin="12,0,0,0" Command="{Binding LoadCommand}" ToolTip="{loc:Tr Common_Refresh}"><TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72C;" FontSize="13" /></Button>
        </StackPanel>
        <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,12">
          <StackPanel><TextBlock Style="{StaticResource Text.Muted}" Text="{loc:Tr Common_Min}" /><TextBlock Style="{StaticResource Text.Metric}" Text="{Binding StatMin}" /></StackPanel>
          <StackPanel><TextBlock Style="{StaticResource Text.Muted}" Text="{loc:Tr Common_Max}" /><TextBlock Style="{StaticResource Text.Metric}" Text="{Binding StatMax}" /></StackPanel>
          <StackPanel><TextBlock Style="{StaticResource Text.Muted}" Text="{loc:Tr Common_Avg}" /><TextBlock Style="{StaticResource Text.Metric}" Text="{Binding StatAvg}" /></StackPanel>
          <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding StatCount}" VerticalAlignment="Bottom" />
        </UniformGrid>
        <Grid>
          <lvc:CartesianChart Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" LegendPosition="Bottom" ZoomMode="X" AnimationsSpeed="0:0:0" />
          <TextBlock Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{loc:Tr Hist_Pick}"
                     Visibility="{Binding Selected, Converter={StaticResource NullToVisInv}}" />
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{loc:Tr Hist_Empty}" Foreground="{DynamicResource Brush.TextMuted}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding HasData}" Value="False" />
                      <Condition Binding="{Binding Selected, Converter={StaticResource NullToVis}}" Value="Visible" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
