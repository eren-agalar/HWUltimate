<UserControl x:Class="NovaHardware.App.Views.OverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NovaHardware.UI.Localization;assembly=NovaHardware.UI"
             xmlns:ui="clr-namespace:NovaHardware.UI.Controls;assembly=NovaHardware.UI"
             xmlns:conv="clr-namespace:NovaHardware.UI.Converters;assembly=NovaHardware.UI"
             xmlns:local="clr-namespace:NovaHardware.App.Views"
             xmlns:core="clr-namespace:NovaHardware.Core.Overlay;assembly=NovaHardware.Core">
  <UserControl.Resources>
    <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
      <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
  </UserControl.Resources>
  <ScrollViewer Padding="20,2,8,16">
    <StackPanel>
      <DockPanel Margin="0,0,12,12">
        <Button DockPanel.Dock="Right" Style="{StaticResource Nova.Button.Primary}" Command="{Binding ToggleOverlayCommand}" MinWidth="150">
          <StackPanel Orientation="Horizontal">
            <ui:Icon Kind="Overlay" Width="14" Height="14" Margin="0,0,7,0" Foreground="{DynamicResource Brush.OnAccent}" />
            <TextBlock x:Name="ToggleText" Text="{loc:Tr Overlay_Show}" />
          </StackPanel>
        </Button>
        <TextBlock Style="{StaticResource Text.PageTitle}" Text="{loc:Tr Nav_Overlay}" VerticalAlignment="Center" />
        <ui:NovaStatusIndicator Margin="14,4,0,0" Text="{loc:Tr Overlay_Visible}" Status="Normal" Visibility="{Binding Controller.IsVisible, Converter={StaticResource BoolToVis}}" />
      </DockPanel>
      <TextBlock Style="{StaticResource Text.Muted}" Text="{loc:Tr Overlay_Intro}" Margin="0,0,12,12" MaxWidth="900" HorizontalAlignment="Left" />
      <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource Brush.Bad}" Padding="12,8" Visibility="{Binding ValidationMessage, Converter={StaticResource NullToVis}}">
        <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource Brush.Bad}" TextWrapping="Wrap" />
      </Border>

      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="340" /></Grid.ColumnDefinitions>

        <StackPanel>
          <!-- Metrics -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Overlay_Metrics}" />
              <WrapPanel Margin="0,0,0,10">
                <RadioButton Style="{StaticResource Chip}" Content="{loc:Tr Overlay_Preset_Minimal}" IsChecked="{Binding Preset, Converter={StaticResource EnumEquals}, ConverterParameter=Minimal}" />
                <RadioButton Style="{StaticResource Chip}" Content="{loc:Tr Overlay_Preset_Gaming}" IsChecked="{Binding Preset, Converter={StaticResource EnumEquals}, ConverterParameter=Gaming}" />
                <RadioButton Style="{StaticResource Chip}" Content="{loc:Tr Overlay_Preset_FullHardware}" IsChecked="{Binding Preset, Converter={StaticResource EnumEquals}, ConverterParameter=FullHardware}" />
                <RadioButton Style="{StaticResource Chip}" Content="{loc:Tr Overlay_Preset_Custom}" IsChecked="{Binding Preset, Converter={StaticResource EnumEquals}, ConverterParameter=Custom}" />
              </WrapPanel>
              <ItemsControl ItemsSource="{Binding Metrics}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,1,16,1">
                      <ui:NovaIconButton DockPanel.Dock="Right" Icon="ArrowDown" IconSize="11" Padding="4" MinHeight="0" Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="{loc:Tr Explorer_MoveDown}" />
                      <ui:NovaIconButton DockPanel.Dock="Right" Icon="ArrowUp" IconSize="11" Padding="4" MinHeight="0" Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="{loc:Tr Explorer_MoveUp}" />
                      <CheckBox IsChecked="{Binding IsEnabled}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Label}" />
                          <TextBlock Text=" · PresentMon" Foreground="{DynamicResource Brush.TextMuted}" FontSize="{DynamicResource Size.FontSmall}" VerticalAlignment="Center"
                                     Visibility="{Binding NeedsFrameSource, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                      </CheckBox>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Label}" Text="{loc:Tr Overlay_Gpu}" />
              <ComboBox ItemsSource="{Binding Gpus}" SelectedItem="{Binding Gpu}" DisplayMemberPath="Label" HorizontalAlignment="Left" MinWidth="280" />
            </StackPanel>
          </Border>

          <!-- Appearance -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Overlay_Appearance}" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="24" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel>
                  <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Small}" Text="{Binding BackgroundOpacity, Converter={x:Static conv:PercentConverter.Instance}}" Margin="0,10,0,4" /><TextBlock Style="{StaticResource Label}" Text="{loc:Tr Overlay_Opacity}" /></DockPanel>
                  <Slider Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding BackgroundOpacity, Delay=150}" />
                  <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Small}" Text="{Binding Scale, Converter={x:Static conv:PercentConverter.Instance}}" Margin="0,10,0,4" /><TextBlock Style="{StaticResource Label}" Text="{loc:Tr Overlay_Scale}" /></DockPanel>
                  <Slider Minimum="0.5" Maximum="2.5" SmallChange="0.05" LargeChange="0.25" Value="{Binding Scale, Delay=150}" />
                  <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Small}" Text="{Binding FontSize, StringFormat={}{0:0} px}" Margin="0,10,0,4" /><TextBlock Style="{StaticResource Label}" Text="{loc:Tr Overlay_FontSize}" /></DockPanel>
                  <Slider Minimum="9" Maximum="28" SmallChange="1" LargeChange="2" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding FontSize, Delay=150}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource Label}" Text="{loc:Tr Overlay_TextColor}" />
                  <DockPanel>
                    <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Swatches}" Margin="8,0,0,0">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Width="18" Height="18" MinHeight="0" Padding="0" Margin="2,0" ToolTip="{Binding Name}" Command="{Binding DataContext.SetTextColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Hex}">
                            <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="9" Background="{Binding Hex, Converter={x:Static conv:HexToBrushConverter.Instance}}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" /></ControlTemplate></Button.Template>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Text="{Binding TextColor, UpdateSourceTrigger=PropertyChanged, Delay=300}" FontFamily="{StaticResource Font.Mono}" />
                  </DockPanel>
                  <TextBlock Style="{StaticResource Label}" Text="{loc:Tr Overlay_AccentColor}" />
                  <DockPanel>
                    <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Swatches}" Margin="8,0,0,0">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Width="18" Height="18" MinHeight="0" Padding="0" Margin="2,0" ToolTip="{Binding Name}" Command="{Binding DataContext.SetAccentColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Hex}">
                            <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="9" Background="{Binding Hex, Converter={x:Static conv:HexToBrushConverter.Instance}}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" /></ControlTemplate></Button.Template>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged, Delay=300}" FontFamily="{StaticResource Font.Mono}" />
                  </DockPanel>
                  <TextBlock Style="{StaticResource Label}" Text="{loc:Tr Overlay_BackgroundColor}" />
                  <TextBox Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged, Delay=300}" FontFamily="{StaticResource Font.Mono}" />
                </StackPanel>
              </Grid>
              <WrapPanel Margin="0,12,0,0">
                <ToggleButton Style="{StaticResource NovaToggle}" IsChecked="{Binding ShowLabels}" Content="{loc:Tr Overlay_ShowLabels}" Margin="0,0,24,0" />
                <ToggleButton Style="{StaticResource NovaToggle}" IsChecked="{Binding ShowGraphs}" Content="{loc:Tr Overlay_ShowGraphs}" Margin="0,0,24,0" />
                <ToggleButton Style="{StaticResource NovaToggle}" IsChecked="{Binding IsHorizontal}" Content="{loc:Tr Overlay_Horizontal}" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- Behaviour -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Overlay_Behaviour}" />
              <ToggleButton Style="{StaticResource NovaToggle}" IsChecked="{Binding ClickThrough}" Content="{loc:Tr Overlay_ClickThrough}" />
              <TextBlock Style="{StaticResource Text.Small}" Text="{loc:Tr Overlay_ClickThroughHint}" Margin="0,0,0,6" />
              <ToggleButton Style="{StaticResource NovaToggle}" IsChecked="{Binding ShowOnStartup}" Content="{loc:Tr Overlay_ShowOnStartup}" />
              <ToggleButton Style="{StaticResource NovaToggle}" IsChecked="{Binding AutoHideWhenNovaActive}" Content="{loc:Tr Overlay_AutoHideNova}" />
              <ToggleButton Style="{StaticResource NovaToggle}" IsChecked="{Binding AutoHideWithoutGame}" Content="{loc:Tr Overlay_AutoHideGame}" />
              <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="24" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource Label}" Text="{loc:Tr Overlay_Hotkey}" />
                  <TextBox Text="{Binding Hotkey, UpdateSourceTrigger=PropertyChanged, Delay=500}" />
                  <TextBlock Style="{StaticResource Text.Small}" Text="{Binding Controller.HotkeyStatus}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource Label}" Text="{loc:Tr Overlay_Refresh}" />
                  <ComboBox ItemsSource="{Binding RefreshIntervals}" SelectedItem="{Binding RefreshIntervalMs}" ItemStringFormat="{}{0} ms" HorizontalAlignment="Left" />
                </StackPanel>
              </Grid>
              <Button Content="{loc:Tr Overlay_ResetPosition}" Command="{Binding ResetPositionCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" />
            </StackPanel>
          </Border>

          <!-- FPS source -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Overlay_FpsSource}" />
              <TextBlock Style="{StaticResource Text.Muted}" Text="{loc:Tr Overlay_FpsExplain}" />
              <TextBlock Style="{StaticResource Label}" Text="{loc:Tr Overlay_PresentMonPath}" />
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="{loc:Tr Common_Browse}" Command="{Binding BrowsePresentMonCommand}" Margin="8,0,0,0" />
                <TextBox Text="{Binding PresentMonPath, UpdateSourceTrigger=PropertyChanged, Delay=500}" />
              </DockPanel>
              <TextBlock Style="{StaticResource Text.Small}" Text="{Binding PresentMonStatus}" Margin="0,6,0,0" />
              <TextBlock Style="{StaticResource Text.Small}" Text="{Binding Controller.FrameStatus}" Margin="0,2,0,0" />
              <Button Content="{loc:Tr Overlay_GetPresentMon}" Command="{Binding OpenPresentMonPageCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Live preview -->
        <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Overlay_Preview}" />
            <Border CornerRadius="9" Padding="12,9" HorizontalAlignment="Left" Grid.IsSharedSizeScope="True">
              <Border.Background>
                <MultiBinding Converter="{x:Static conv:HexToBrushConverter.Instance}">
                  <Binding Path="BackgroundColor" />
                  <Binding Path="BackgroundOpacity" />
                </MultiBinding>
              </Border.Background>
              <Border.LayoutTransform><ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" /></Border.LayoutTransform>
              <ItemsControl ItemsSource="{Binding Controller.Items}" TextElement.FontSize="{Binding FontSize}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,1">
                      <Grid.ColumnDefinitions><ColumnDefinition SharedSizeGroup="L" /><ColumnDefinition SharedSizeGroup="V" /></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Label}" Margin="0,0,10,0" Opacity="0.75" Foreground="{Binding DataContext.AccentColor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                      <TextBlock Grid.Column="1" Text="{Binding Text}" FontWeight="SemiBold" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"
                                 Foreground="{Binding DataContext.TextColor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <TextBlock Style="{StaticResource Text.Small}" Text="{loc:Tr Overlay_PreviewHint}" Margin="0,10,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
