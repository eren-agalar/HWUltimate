<UserControl x:Class="NovaHardware.App.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NovaHardware.UI.Localization;assembly=NovaHardware.UI"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
  <ScrollViewer Padding="24,4,12,24">
    <StackPanel>
      <DockPanel Margin="0,0,12,16">
        <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsBusy, Converter={x:Static local:InverseBool.Instance}}" xmlns:local="clr-namespace:NovaHardware.App.Views">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0" />
            <TextBlock Text="{loc:Tr Common_Refresh}" />
          </StackPanel>
        </Button>
        <TextBlock Style="{StaticResource Text.PageTitle}" Text="{loc:Tr Nav_Hardware}" Margin="0" />
        <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Collected}" VerticalAlignment="Center" Margin="16,6,0,0" />
      </DockPanel>
      <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,12,12" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Hw_Summary}" />
          <ItemsControl ItemsSource="{Binding Summary}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <TextBlock Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding Label}" />
                  <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="2,10,0,10">
                <TextBlock Style="{StaticResource Text.Icon}" Text="{Binding Glyph}" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0" />
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Category}" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="0">
                      <Expander Padding="16,12" Foreground="{DynamicResource Brush.Text}">
                        <Expander.Header>
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Muted}" FontSize="11" Text="{Binding Source}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          </DockPanel>
                        </Expander.Header>
                        <ItemsControl ItemsSource="{Binding Properties}" Margin="20,8,0,4">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBlock Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding Name}" />
                                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" TextWrapping="Wrap" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Expander>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,8,12,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate><TextBlock Style="{StaticResource Text.Muted}" Text="{Binding}" /></DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
