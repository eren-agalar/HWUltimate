<UserControl x:Class="NovaHardware.App.Views.SensorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NovaHardware.UI.Localization;assembly=NovaHardware.UI"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
  <DockPanel Margin="24,4,24,24">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Style="{StaticResource Text.PageTitle}" Text="{loc:Tr Nav_Sensors}" Margin="0" VerticalAlignment="Center" />
      <Button DockPanel.Dock="Right" Content="{loc:Tr Sensors_Reset}" Command="{Binding ResetStatisticsCommand}" />
      <TextBox DockPanel.Dock="Right" Width="260" Margin="0,0,10,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
               ToolTip="{loc:Tr Common_Search}" AutomationProperties.Name="{loc:Tr Common_Search}" />
      <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Summary}" VerticalAlignment="Center" Margin="16,6,0,0" />
    </DockPanel>
    <Border Style="{StaticResource Card}" Margin="0" Padding="6">
      <DataGrid ItemsSource="{Binding View}" IsReadOnly="True" CanUserSortColumns="False">
        <DataGrid.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <TextBlock Margin="8,14,0,6" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" Text="{Binding Name}" />
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </DataGrid.GroupStyle>
        <DataGrid.Columns>
          <DataGridTextColumn Header="{loc:Tr Common_Sensor}" Binding="{Binding Name}" Width="2*" />
          <DataGridTextColumn Header="{loc:Tr Common_Type}" Binding="{Binding TypeName}" Width="*">
            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" /></Style></DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="{loc:Tr Common_Current}" Binding="{Binding Current}" Width="*" ElementStyle="{StaticResource Cell.Numeric}" FontWeight="SemiBold" />
          <DataGridTextColumn Header="{loc:Tr Common_Min}" Binding="{Binding Minimum}" Width="*" ElementStyle="{StaticResource Cell.Numeric}" />
          <DataGridTextColumn Header="{loc:Tr Common_Max}" Binding="{Binding Maximum}" Width="*" ElementStyle="{StaticResource Cell.Numeric}" />
          <DataGridTextColumn Header="{loc:Tr Common_Avg}" Binding="{Binding Average}" Width="*" ElementStyle="{StaticResource Cell.Numeric}" />
          <DataGridTemplateColumn Header="{loc:Tr Sensors_Quality}" Width="0.8*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Quality, Converter={StaticResource QualityText}}" Foreground="{Binding Quality, Converter={StaticResource QualityBrush}}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="{loc:Tr Common_Source}" Binding="{Binding Provider}" Width="*">
            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" /></Style></DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</UserControl>
