<Window x:Class="NovaHardware.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:NovaHardware.UI.Controls;assembly=NovaHardware.UI"
        Title="Nova Overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource Font.Ui}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Border x:Name="Frame" CornerRadius="9" Padding="12,9" MouseLeftButtonDown="Frame_MouseLeftButtonDown">
    <Border.LayoutTransform><ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" /></Border.LayoutTransform>
    <ItemsControl x:Name="Lines" Focusable="False">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel x:Name="Panel" Orientation="Vertical" Loaded="Panel_Loaded" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,1,14,1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition SharedSizeGroup="Label" />
              <ColumnDefinition SharedSizeGroup="Value" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LabelText" Text="{Binding Label}" Margin="0,0,10,0" Opacity="0.75" VerticalAlignment="Center"
                       Foreground="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock x:Name="ValueText" Grid.Column="1" Text="{Binding Text}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Typography.NumeralAlignment="Tabular" Foreground="{Binding TextBrush, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding Detail}" />
            <ui:Sparkline x:Name="Graph" Grid.Column="2" Width="56" Height="14" Margin="10,0,0,0" Samples="{Binding Samples}" Version="{Binding Version}"
                          Stroke="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                          Visibility="{Binding ShowGraphs, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
          </Grid>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsAvailable}" Value="False"><Setter TargetName="ValueText" Property="Opacity" Value="0.55" /></DataTrigger>
            <DataTrigger Binding="{Binding ShowLabels, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
              <Setter TargetName="LabelText" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Border>
</Window>
