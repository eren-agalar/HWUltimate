<UserControl x:Class="NovaHardware.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NovaHardware.UI.Localization;assembly=NovaHardware.UI"
             xmlns:ui="clr-namespace:NovaHardware.UI.Controls;assembly=NovaHardware.UI"
             xmlns:conv="clr-namespace:NovaHardware.UI.Converters;assembly=NovaHardware.UI"
             xmlns:local="clr-namespace:NovaHardware.App.Views">
  <UserControl.Resources>
    <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
      <Setter Property="Margin" Value="0,12,0,4" />
    </Style>
    <Style x:Key="Page" TargetType="StackPanel">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="MaxWidth" Value="860" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
  </UserControl.Resources>

  <DockPanel Margin="20,2,20,16">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Content="{loc:Tr Settings_Restart}" Command="{Binding RestartAppCommand}" Visibility="{Binding RestartRequired, Converter={StaticResource BoolToVis}}" />
      <TextBlock Style="{StaticResource Text.PageTitle}" Text="{loc:Tr Nav_Settings}" VerticalAlignment="Center" />
      <TextBlock Margin="16,6,0,0" VerticalAlignment="Center" Text="{Binding Message}" TextTrimming="CharacterEllipsis">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Bad}" /></DataTrigger></Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </DockPanel>

    <!-- Section navigation -->
    <ListBox DockPanel.Dock="Left" Width="190" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" ItemContainerStyle="{StaticResource Nova.ListItem}" Margin="0,0,16,0" VerticalAlignment="Top">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <ui:Icon Kind="{Binding Icon}" Width="15" Height="15" Margin="0,0,10,0" Foreground="{DynamicResource Brush.TextMuted}" />
            <TextBlock Text="{Binding Title}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <ScrollViewer>
      <Grid>
        <!-- ===================== Appearance -->
        <StackPanel x:Name="Appearance" Style="{StaticResource Page}">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Settings_Theme}" />
              <ItemsControl ItemsSource="{Binding Themes}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <RadioButton GroupName="Theme" Margin="0,0,10,10" Cursor="Hand" Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Choice}"
                                 Loaded="Theme_Loaded">
                      <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                          <Border x:Name="Card" Width="150" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource Brush.Line}" Padding="3">
                            <StackPanel>
                              <!-- Live miniature of the theme -->
                              <Border Height="74" CornerRadius="7" Background="{Binding Background, Converter={x:Static conv:HexToBrushConverter.Instance}}">
                                <Grid Margin="8">
                                  <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                  <StackPanel>
                                    <Border Height="5" Margin="0,2" CornerRadius="2" Background="{Binding Accent, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                                    <Border Height="5" Margin="0,2" CornerRadius="2" Background="{Binding Muted, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                                    <Border Height="5" Margin="0,2" CornerRadius="2" Background="{Binding Muted, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                                  </StackPanel>
                                  <Border Grid.Column="1" Margin="6,0,0,0" CornerRadius="5" Background="{Binding Panel, Converter={x:Static conv:HexToBrushConverter.Instance}}" Padding="6">
                                    <StackPanel>
                                      <Border Height="5" Width="40" HorizontalAlignment="Left" CornerRadius="2" Background="{Binding Text, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                                      <Border Height="4" Margin="0,6,0,0" CornerRadius="2" Background="{Binding Muted, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                                      <Border Height="4" Margin="0,4,0,0" Width="50" HorizontalAlignment="Left" CornerRadius="2" Background="{Binding Accent, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                                    </StackPanel>
                                  </Border>
                                </Grid>
                              </Border>
                              <TextBlock Text="{Binding Name}" Margin="6,6,6,4" Foreground="{DynamicResource Brush.Text}" />
                            </StackPanel>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.TextMuted}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" /></Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </RadioButton.Template>
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Text.Small}" Text="{loc:Tr Settings_SystemThemeHint}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Settings_Accent}" />
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="{loc:Tr Settings_ResetDefault}" Command="{Binding ResetAccentCommand}" Margin="8,0,0,0" />
                <TextBox DockPanel.Dock="Right" Width="110" Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged, Delay=400}" FontFamily="{StaticResource Font.Mono}" ToolTip="#RRGGBB" />
                <ItemsControl ItemsSource="{Binding AccentPresets}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Width="26" Height="26" MinHeight="0" Padding="0" Margin="0,0,8,0" ToolTip="{Binding Name}" Command="{Binding DataContext.SetAccentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Hex}">
                        <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="13" Background="{Binding Hex, Converter={x:Static conv:HexToBrushConverter.Instance}}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="2" /></ControlTemplate></Button.Template>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DockPanel>

              <TextBlock Style="{StaticResource Label}" Text="{loc:Tr Settings_StatusColors}" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <ui:NovaStatusIndicator Status="Normal" Text="{loc:Tr Status_Normal}" Margin="0,0,0,4" />
                  <TextBox Text="{Binding NormalColor, UpdateSourceTrigger=PropertyChanged, Delay=400}" FontFamily="{StaticResource Font.Mono}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <ui:NovaStatusIndicator Status="Warning" Text="{loc:Tr Status_Warning}" Margin="0,0,0,4" />
                  <TextBox Text="{Binding WarningColor, UpdateSourceTrigger=PropertyChanged, Delay=400}" FontFamily="{StaticResource Font.Mono}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <ui:NovaStatusIndicator Status="Critical" Text="{loc:Tr Status_Critical}" Margin="0,0,0,4" />
                  <TextBox Text="{Binding CriticalColor, UpdateSourceTrigger=PropertyChanged, Delay=400}" FontFamily="{StaticResource Font.Mono}" />
                </StackPanel>
                <Button Grid.Column="5" VerticalAlignment="Bottom" Margin="10,0,0,0" Content="{loc:Tr Settings_ResetDefault}" Command="{Binding ResetStatusColorsCommand}" />
              </Grid>
              <TextBlock Style="{StaticResource Text.Small}" Text="{loc:Tr Settings_StatusHint}" Margin="0,6,0,0" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Settings_Interface}" />
              <ToggleButton Style="{StaticResource NovaToggle}" IsChecked="{Binding AnimationsEnabled}" Content="{loc:Tr Settings_Animations}" />
              <ToggleButton Style="{StaticResource NovaToggle}" IsChecked="{Binding IsComfortable}" Content="{loc:Tr Settings_Comfortable}" />
              <TextBlock Style="{StaticResource Label}" Text="{loc:Tr Settings_Typography}" />
              <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource Chip}" Content="{loc:Tr Typography_Small}" IsChecked="{Binding Typography, Converter={StaticResource EnumEquals}, ConverterParameter=Small}" />
                <RadioButton Style="{StaticResource Chip}" Content="{loc:Tr Typography_Default}" IsChecked="{Binding Typography, Converter={StaticResource EnumEquals}, ConverterParameter=Default}" />
                <RadioButton Style="{StaticResource Chip}" Content="{loc:Tr Typography_Large}" IsChecked="{Binding Typography, Converter={StaticResource EnumEquals}, ConverterParameter=Large}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ===================== Sensors -->
        <StackPanel x:Name="Sensors" Style="{StaticResource Page}">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Settings_Polling}" />
              <ComboBox ItemsSource="{Binding PollingIntervals}" SelectedItem="{Binding PollingIntervalMs}" ItemStringFormat="{}{0} ms" HorizontalAlignment="Left" />
              <TextBlock Style="{StaticResource Text.Small}" Text="{loc:Tr Settings_PollingHint}" Margin="0,6,0,0" />
              <TextBlock Style="{StaticResource Label}" Text="{loc:Tr Settings_ExplorerRefresh}" />
              <ComboBox ItemsSource="{Binding Explorer.RefreshIntervals}" SelectedItem="{Binding Explorer.RefreshIntervalMs}" ItemStringFormat="{}{0} ms" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Settings_DisplayMode}" />
              <ToggleButton Style="{StaticResource NovaToggle}" IsChecked="{Binding Explorer.IsAdvanced}" Content="{loc:Tr Settings_AdvancedDefault}" />
              <TextBlock Style="{StaticResource Label}" Text="{loc:Tr Explorer_Columns}" />
              <WrapPanel>
                <CheckBox Content="{loc:Tr Col_Value}" IsChecked="{Binding Explorer.ShowValue}" Margin="0,0,16,4" />
                <CheckBox Content="{loc:Tr Col_Minimum}" IsChecked="{Binding Explorer.ShowMinimum}" Margin="0,0,16,4" />
                <CheckBox Content="{loc:Tr Col_Maximum}" IsChecked="{Binding Explorer.ShowMaximum}" Margin="0,0,16,4" />
                <CheckBox Content="{loc:Tr Col_Average}" IsChecked="{Binding Explorer.ShowAverage}" Margin="0,0,16,4" />
                <CheckBox Content="{loc:Tr Col_Type}" IsChecked="{Binding Explorer.ShowType}" Margin="0,0,16,4" />
                <CheckBox Content="{loc:Tr Col_Provider}" IsChecked="{Binding Explorer.ShowProvider}" Margin="0,0,16,4" />
                <CheckBox Content="{loc:Tr Col_Quality}" IsChecked="{Binding Explorer.ShowQuality}" Margin="0,0,16,4" />
                <CheckBox Content="{loc:Tr Col_SensorId}" IsChecked="{Binding Explorer.ShowSensorId}" Margin="0,0,16,4" />
                <CheckBox Content="{loc:Tr Col_Samples}" IsChecked="{Binding Explorer.ShowSamples}" Margin="0,0,16,4" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Settings_SensorPrefs}" />
              <WrapPanel>
                <Button Content="{loc:Tr Explorer_UnhideAll}" Command="{Binding Explorer.UnhideAllCommand}" Margin="0,0,8,8" />
                <Button Content="{loc:Tr Explorer_ResetOrder}" Command="{Binding Explorer.ResetOrderCommand}" Margin="0,0,8,8" />
                <Button Content="{loc:Tr Settings_ClearFavorites}" Command="{Binding Explorer.ClearFavoritesCommand}" Margin="0,0,8,8" />
              </WrapPanel>
              <TextBlock Style="{StaticResource Text.Small}" Text="{Binding Explorer.Summary}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ===================== Overlay -->
        <StackPanel x:Name="Overlay" Style="{StaticResource Page}">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Nav_Overlay}" />
              <ToggleButton Style="{StaticResource NovaToggle}" IsChecked="{Binding Overlay.ShowOnStartup}" Content="{loc:Tr Overlay_ShowOnStartup}" />
              <ToggleButton Style="{StaticResource NovaToggle}" IsChecked="{Binding Overlay.ClickThrough}" Content="{loc:Tr Overlay_ClickThrough}" />
              <TextBlock Style="{StaticResource Label}" Text="{loc:Tr Overlay_Hotkey}" />
              <TextBox Text="{Binding Overlay.Hotkey, UpdateSourceTrigger=PropertyChanged, Delay=500}" Width="220" HorizontalAlignment="Left" />
              <TextBlock Style="{StaticResource Text.Small}" Text="{Binding Overlay.Controller.HotkeyStatus}" Margin="0,4,0,0" />
              <DockPanel Margin="0,12,0,4"><TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Small}" Text="{Binding Overlay.BackgroundOpacity, Converter={x:Static conv:PercentConverter.Instance}}" /><TextBlock Style="{StaticResource Text.Small}" Text="{loc:Tr Overlay_Opacity}" /></DockPanel>
              <Slider Minimum="0" Maximum="1" Value="{Binding Overlay.BackgroundOpacity, Delay=150}" Width="320" HorizontalAlignment="Left" />
              <TextBlock Style="{StaticResource Label}" Text="{loc:Tr Overlay_Refresh}" />
              <ComboBox ItemsSource="{Binding Overlay.RefreshIntervals}" SelectedItem="{Binding Overlay.RefreshIntervalMs}" ItemStringFormat="{}{0} ms" HorizontalAlignment="Left" />
              <WrapPanel Margin="0,14,0,0">
                <Button Content="{loc:Tr Overlay_ResetPosition}" Command="{Binding Overlay.ResetPositionCommand}" Margin="0,0,8,0" />
                <Button Content="{loc:Tr Settings_OpenOverlayPage}" Click="OpenOverlay_Click" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ===================== Alerts -->
        <StackPanel x:Name="Alerts" Style="{StaticResource Page}">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Nav_Alerts}" />
              <ToggleButton Style="{StaticResource NovaToggle}" IsChecked="{Binding Alerts.NotificationsEnabled}" Content="{loc:Tr Alerts_Notifications}" />
              <TextBlock Style="{StaticResource Text.Small}" Text="{loc:Tr Settings_AlertsHint}" Margin="0,6,0,10" />
              <WrapPanel>
                <Button Style="{StaticResource Nova.Button.Primary}" Content="{loc:Tr Common_Save}" Command="{Binding Alerts.SaveCommand}" Margin="0,0,8,0" />
                <Button Content="{loc:Tr Settings_OpenAlertsPage}" Click="OpenAlerts_Click" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ===================== General -->
        <StackPanel x:Name="General" Style="{StaticResource Page}">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Settings_Language}" />
              <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" DisplayMemberPath="Name" HorizontalAlignment="Left" MinWidth="220" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Settings_Startup}" />
              <ToggleButton Style="{StaticResource NovaToggle}" IsChecked="{Binding LaunchWithWindows}" Content="{loc:Tr Settings_LaunchWithWindows}" />
              <ToggleButton Style="{StaticResource NovaToggle}" IsChecked="{Binding StartMinimized}" Content="{loc:Tr Settings_StartMinimized}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Settings_Providers}" />
              <ToggleButton Style="{StaticResource NovaToggle}" IsChecked="{Binding EnableNvidia}" Content="{loc:Tr Settings_Nvidia}" />
              <ToggleButton Style="{StaticResource NovaToggle}" IsChecked="{Binding EnableAmd}" Content="{loc:Tr Settings_Amd}" />
              <ItemsControl ItemsSource="{Binding Providers}" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,3">
                      <ui:NovaStatusIndicator x:Name="Dot" DockPanel.Dock="Left" Status="Inactive" Margin="0,4,10,0" VerticalAlignment="Top" />
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Text.Small}" Text="{Binding Message}" />
                      </StackPanel>
                    </DockPanel>
                    <DataTemplate.Triggers><DataTrigger Binding="{Binding IsAvailable}" Value="True"><Setter TargetName="Dot" Property="Status" Value="Normal" /></DataTrigger></DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Settings_Data}" />
              <TextBox Style="{StaticResource Text.Selectable}" Text="{Binding DataFolder, Mode=OneWay}" Margin="0,0,0,8" FontFamily="{StaticResource Font.Mono}" />
              <ToggleButton Style="{StaticResource NovaToggle}" IsChecked="{Binding VerboseLogging}" Content="{loc:Tr Settings_VerboseLogging}" />
              <WrapPanel Margin="0,8,0,0">
                <Button Content="{loc:Tr Settings_OpenData}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                <Button Content="{loc:Tr Settings_OpenLogs}" Command="{Binding OpenLogsCommand}" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Settings_About}" />
              <TextBlock FontWeight="SemiBold"><Run Text="Nova Hardware " /><Run Text="{Binding Version, Mode=OneWay}" /></TextBlock>
              <TextBlock Style="{StaticResource Text.Muted}" Text="{loc:Tr App_Tagline}" />
              <TextBlock Style="{StaticResource Text.Small}" Margin="0,8,0,0" Text="{loc:Tr Settings_Licenses}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
