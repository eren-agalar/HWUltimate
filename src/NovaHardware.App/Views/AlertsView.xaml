<UserControl x:Class="NovaHardware.App.Views.AlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NovaHardware.UI.Localization;assembly=NovaHardware.UI"
             xmlns:ui="clr-namespace:NovaHardware.UI.Controls;assembly=NovaHardware.UI"
             xmlns:vm="clr-namespace:NovaHardware.App.ViewModels"
             xmlns:local="clr-namespace:NovaHardware.App.Views">
  <ScrollViewer Padding="20,2,8,16">
    <StackPanel>
      <DockPanel Margin="0,0,12,12">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <ToggleButton Style="{StaticResource NovaToggle}" IsChecked="{Binding NotificationsEnabled}" Content="{loc:Tr Alerts_Notifications}" Margin="0,0,16,0" VerticalAlignment="Center" />
          <Button Content="{loc:Tr Alerts_Defaults}" Command="{Binding RestoreDefaultsCommand}" Margin="0,0,8,0" />
          <Button Style="{StaticResource Nova.Button.Primary}" Content="{loc:Tr Common_Save}" Command="{Binding SaveCommand}" MinWidth="96" />
        </StackPanel>
        <TextBlock Style="{StaticResource Text.PageTitle}" Text="{loc:Tr Nav_Alerts}" VerticalAlignment="Center" />
      </DockPanel>
      <TextBlock Style="{StaticResource Text.Muted}" Text="{loc:Tr Alerts_Intro}" Margin="0,0,12,12" MaxWidth="900" HorizontalAlignment="Left" />
      <Border Style="{StaticResource Card}" Padding="12,8" Visibility="{Binding Message, Converter={StaticResource NullToVis}}">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Good}" />
              <Style.Triggers><DataTrigger Binding="{Binding HasErrors}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Bad}" /></DataTrigger></Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Border>

      <!-- Component rules -->
      <ItemsControl ItemsSource="{Binding ComponentRules}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:ComponentRuleRow}">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <ToggleButton Style="{StaticResource NovaToggle}" IsChecked="{Binding Enabled}">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                </ToggleButton>
                <TextBlock Style="{StaticResource Text.Small}" Text="{Binding Description}" Margin="0,2,0,8" />
                <StackPanel Visibility="{Binding HasThresholds, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding Enabled}">
                  <ToggleButton Style="{StaticResource NovaToggle}" IsChecked="{Binding UseAutomatic}" Content="{loc:Tr Alerts_Automatic}" />
                  <Grid Margin="0,6,0,0" IsEnabled="{Binding UseAutomatic, Converter={x:Static local:InverseBool.Instance}}">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Style="{StaticResource Text.Small}" Text="{loc:Tr Alerts_Warning}" Margin="0,0,0,4" />
                      <TextBox Text="{Binding Warning, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Style="{StaticResource Text.Small}" Text="{loc:Tr Alerts_Critical}" Margin="0,0,0,4" />
                      <TextBox Text="{Binding Critical, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Style="{StaticResource Text.Small}" Text="{loc:Tr Alerts_InEffect}" Margin="0,10,0,2" FontWeight="SemiBold" />
                  <TextBlock Style="{StaticResource Text.Small}" Text="{Binding Effective}" />
                </StackPanel>
                <Grid Margin="0,10,0,0" IsEnabled="{Binding Enabled}">
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Text.Small}" Text="{loc:Tr Alerts_Hysteresis}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Hysteresis, UpdateSourceTrigger=LostFocus}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Text.Small}" Text="{loc:Tr Alerts_Sustain}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SustainSeconds, UpdateSourceTrigger=LostFocus}" />
                  </StackPanel>
                  <StackPanel Grid.Column="4">
                    <TextBlock Style="{StaticResource Text.Small}" Text="{loc:Tr Alerts_Cooldown}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding CooldownMinutes, UpdateSourceTrigger=LostFocus}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Custom rules -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <ui:NovaIconButton Icon="ArrowUp" Label="{loc:Tr Common_Add}" Command="{Binding AddRuleCommand}" Style="{StaticResource Nova.IconButton.Bordered}" Margin="0,0,6,0" />
              <ui:NovaIconButton Icon="Close" Label="{loc:Tr Common_Remove}" Command="{Binding RemoveRuleCommand}" Style="{StaticResource Nova.IconButton.Bordered}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Alerts_CustomRules}" VerticalAlignment="Center" Margin="0" />
          </DockPanel>
          <DataGrid ItemsSource="{Binding CustomRules}" SelectedItem="{Binding SelectedCustomRule}" MinHeight="80" MaxHeight="260">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="{loc:Tr Alerts_Enabled}" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="50" />
              <DataGridTextColumn Header="{loc:Tr Alerts_Name}" Binding="{Binding Name}" Width="2*" />
              <DataGridComboBoxColumn Header="{loc:Tr Common_Type}" SelectedItemBinding="{Binding SensorType}" Width="*" ItemsSource="{x:Static vm:AlertsViewModel.SensorTypes}" />
              <DataGridComboBoxColumn Header="{loc:Tr Alerts_Category}" SelectedItemBinding="{Binding DeviceCategory}" Width="*" ItemsSource="{x:Static vm:AlertsViewModel.Categories}" />
              <DataGridComboBoxColumn Header="{loc:Tr Alerts_Comparison}" SelectedItemBinding="{Binding Comparison}" Width="0.8*" ItemsSource="{x:Static vm:AlertsViewModel.Comparisons}" />
              <DataGridTextColumn Header="{loc:Tr Alerts_Threshold}" Binding="{Binding Threshold}" Width="0.7*" />
              <DataGridComboBoxColumn Header="{loc:Tr Alerts_Severity}" SelectedItemBinding="{Binding Severity}" Width="0.9*" ItemsSource="{x:Static vm:AlertsViewModel.Severities}" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <!-- Events -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="{loc:Tr Common_Clear}" Command="{Binding ClearEventsCommand}" />
            <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Alerts_Events}" VerticalAlignment="Center" Margin="0" />
          </DockPanel>
          <TextBlock Style="{StaticResource Text.Muted}" Text="{loc:Tr Alerts_None}" Visibility="{Binding Events.Count, Converter={x:Static local:ZeroToVisibility.Instance}}" />
          <ItemsControl ItemsSource="{Binding Events}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:AlertEventRow}">
                <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="0,6">
                  <DockPanel>
                    <ui:NovaStatusIndicator x:Name="Dot" DockPanel.Dock="Left" Status="Warning" Margin="0,3,10,0" VerticalAlignment="Top" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Small}" Text="{Binding Time}" Margin="12,0,0,0" />
                    <StackPanel>
                      <TextBlock TextWrapping="Wrap"><Run Text="{Binding Kind, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  " Foreground="{DynamicResource Brush.TextMuted}" /><Run Text="{Binding Severity, Mode=OneWay}" Foreground="{DynamicResource Brush.TextMuted}" /></TextBlock>
                      <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Message}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Level}" Value="Critical"><Setter TargetName="Dot" Property="Status" Value="Critical" /></DataTrigger>
                  <DataTrigger Binding="{Binding Level}" Value="Information"><Setter TargetName="Dot" Property="Status" Value="Info" /></DataTrigger>
                  <DataTrigger Binding="{Binding IsCleared}" Value="True"><Setter TargetName="Dot" Property="Status" Value="Normal" /></DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
