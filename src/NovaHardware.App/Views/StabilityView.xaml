<UserControl x:Class="NovaHardware.App.Views.StabilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NovaHardware.UI.Localization;assembly=NovaHardware.UI"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:local="clr-namespace:NovaHardware.App.Views">
  <ScrollViewer Padding="24,4,12,24">
    <StackPanel>
      <TextBlock Style="{StaticResource Text.PageTitle}" Text="{loc:Tr Nav_Stability}" />
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition /></Grid.ColumnDefinitions>

        <!-- Configuration -->
        <Border Style="{StaticResource Card}">
          <StackPanel IsEnabled="{Binding IsRunning, Converter={x:Static local:InverseBool.Instance}}">
            <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Stress_Test}" />
            <ItemsControl ItemsSource="{Binding Kinds}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <RadioButton GroupName="StressKind" IsEnabled="{Binding Supported}"
                               Command="{Binding DataContext.SelectKindCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                               Loaded="KindRadio_Loaded">
                    <StackPanel>
                      <TextBlock Text="{Binding Key, Converter={x:Static local:TrConverter.Instance}}" />
                      <TextBlock Style="{StaticResource Text.Muted}" FontSize="11" Text="{Binding Note}" Visibility="{Binding Note, Converter={StaticResource NullToVis}}" MaxWidth="290" />
                    </StackPanel>
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,14,0,4" Text="{loc:Tr Stress_Duration}" />
            <ComboBox ItemsSource="{Binding Durations}" SelectedItem="{Binding DurationMinutes}" HorizontalAlignment="Left">
              <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Converter={x:Static local:MinutesConverter.Instance}}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <DockPanel Margin="0,14,0,4">
              <TextBlock DockPanel.Dock="Right" Text="{Binding Threads}" FontWeight="SemiBold" />
              <TextBlock Style="{StaticResource Text.Muted}" Text="{loc:Tr Stress_Threads}" />
            </DockPanel>
            <Slider Minimum="1" Maximum="{Binding MaxThreads}" Value="{Binding Threads}" IsSnapToTickEnabled="True" TickFrequency="1" />

            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,14,0,4" Text="{loc:Tr Stress_MemorySize}" />
            <TextBox Text="{Binding MemoryMegabytes, UpdateSourceTrigger=PropertyChanged}" Width="140" HorizontalAlignment="Left" />

            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,14,0,4" Text="{loc:Tr Stress_ThermalLimit}" />
            <TextBox Text="{Binding ThermalLimit, UpdateSourceTrigger=PropertyChanged}" Width="140" HorizontalAlignment="Left" />

            <CheckBox Margin="0,14,0,0" Content="{loc:Tr Stress_StopOnError}" IsChecked="{Binding StopOnError}" />

            <Border Margin="0,16,0,0" Padding="12" CornerRadius="8" Background="{DynamicResource Brush.PanelHover}">
              <TextBlock Style="{StaticResource Text.Muted}" FontSize="12" Text="{loc:Tr Stress_Warning}" />
            </Border>
          </StackPanel>
        </Border>

        <!-- Live run -->
        <StackPanel Grid.Column="1">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Style="{StaticResource Button.Primary}" Content="{loc:Tr Common_Start}" Command="{Binding StartCommand}" Margin="0,0,8,0" MinWidth="96" />
                  <Button Style="{StaticResource Button.Danger}" Content="{loc:Tr Common_Stop}" Command="{Binding StopCommand}" MinWidth="96" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding LastOutcome}" Value="Passed"><Setter Property="Foreground" Value="{DynamicResource Brush.Good}" /></DataTrigger>
                        <DataTrigger Binding="{Binding LastOutcome}" Value="Failed"><Setter Property="Foreground" Value="{DynamicResource Brush.Bad}" /></DataTrigger>
                        <DataTrigger Binding="{Binding LastOutcome}" Value="AbortedThermal"><Setter Property="Foreground" Value="{DynamicResource Brush.Bad}" /></DataTrigger>
                        <DataTrigger Binding="{Binding LastOutcome}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource Brush.Bad}" /></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DockPanel>
              <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,0,0,16" />
              <UniformGrid Columns="5">
                <StackPanel><TextBlock Style="{StaticResource Text.Muted}" Text="{loc:Tr Stress_Elapsed}" /><TextBlock Style="{StaticResource Text.Metric}" Text="{Binding Elapsed}" /></StackPanel>
                <StackPanel><TextBlock Style="{StaticResource Text.Muted}" Text="{loc:Tr Stress_Iterations}" /><TextBlock Style="{StaticResource Text.Metric}" Text="{Binding Iterations}" /></StackPanel>
                <StackPanel><TextBlock Style="{StaticResource Text.Muted}" Text="{loc:Tr Stress_Rate}" /><TextBlock Style="{StaticResource Text.Metric}" Text="{Binding Rate}" /></StackPanel>
                <StackPanel>
                  <TextBlock Style="{StaticResource Text.Muted}" Text="{loc:Tr Stress_Errors}" />
                  <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding Errors}" Foreground="{Binding Errors, Converter={x:Static local:ErrorBrush.Instance}}" />
                </StackPanel>
                <StackPanel><TextBlock Style="{StaticResource Text.Muted}" Text="{loc:Tr Stress_MaxTemp}" /><TextBlock Style="{StaticResource Text.Metric}" Text="{Binding MaxTemp}" /></StackPanel>
              </UniformGrid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Height="300">
            <lvc:CartesianChart Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" LegendPosition="Bottom" AnimationsSpeed="0:0:0" />
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Stress_Results}" />
              <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,4,0,8">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding Outcome}" />
                        <TextBlock><Run Text="{Binding StartedAt, StringFormat=g, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Kind, Mode=OneWay}" /></TextBlock>
                      </DockPanel>
                      <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Summary}" />
                      <ItemsControl ItemsSource="{Binding ErrorDetails}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate><TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{DynamicResource Brush.Bad}" Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
