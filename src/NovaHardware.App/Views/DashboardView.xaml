<UserControl x:Class="NovaHardware.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:NovaHardware.UI.Controls;assembly=NovaHardware.UI"
             xmlns:loc="clr-namespace:NovaHardware.UI.Localization;assembly=NovaHardware.UI"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
  <UserControl.Resources>
    <!-- One headline metric: label + value, value coloured when thresholds are given via Tag. -->
    <DataTemplate x:Key="MetricTemplate">
      <StackPanel Margin="0,0,0,14" ToolTip="{Binding Tooltip}">
        <TextBlock Style="{StaticResource Text.Muted}" FontSize="12" Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
        <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding Text}" />
      </StackPanel>
    </DataTemplate>
    <Style x:Key="Gauge" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
      <Setter Property="Height" Value="6" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Margin" Value="0,2,0,16" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer Padding="24,4,12,24">
    <StackPanel>
      <TextBlock Style="{StaticResource Text.PageTitle}" Text="{loc:Tr Nav_Dashboard}" />

      <UniformGrid Columns="3">
        <!-- CPU -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <ui:Icon Kind="Cpu" Width="20" Height="20" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0" VerticalAlignment="Center" />
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="{loc:Tr Dash_Processor}" />
                <TextBlock Style="{StaticResource Text.Muted}" FontSize="11" Text="{Binding CpuName}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DockPanel>
            <ProgressBar Style="{StaticResource Gauge}" Value="{Binding CpuLoad.Value, Mode=OneWay, TargetNullValue=0}"
                         Foreground="{Binding CpuLoad.Value, Converter={StaticResource ThresholdBrush}, ConverterParameter='80,95'}" />
            <UniformGrid Columns="2">
              <ContentPresenter Content="{Binding CpuLoad}" ContentTemplate="{StaticResource MetricTemplate}" Tag="{loc:Tr Dash_Load}" />
              <ContentPresenter Content="{Binding CpuTemp}" ContentTemplate="{StaticResource MetricTemplate}" Tag="{loc:Tr Dash_Temperature}" />
              <ContentPresenter Content="{Binding CpuPower}" ContentTemplate="{StaticResource MetricTemplate}" Tag="{loc:Tr Dash_Power}" />
              <ContentPresenter Content="{Binding CpuClock}" ContentTemplate="{StaticResource MetricTemplate}" Tag="{loc:Tr Dash_Clock}" />
            </UniformGrid>
          </StackPanel>
        </Border>
        <!-- GPU -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <ui:Icon Kind="Gpu" Width="20" Height="20" Foreground="{DynamicResource Brush.Series2}" Margin="0,0,10,0" VerticalAlignment="Center" />
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="{loc:Tr Dash_Graphics}" />
                <TextBlock Style="{StaticResource Text.Muted}" FontSize="11" Text="{Binding GpuName}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DockPanel>
            <ProgressBar Style="{StaticResource Gauge}" Value="{Binding GpuLoad.Value, Mode=OneWay, TargetNullValue=0}"
                         Foreground="{Binding GpuLoad.Value, Converter={StaticResource ThresholdBrush}, ConverterParameter='85,98'}" />
            <UniformGrid Columns="2">
              <ContentPresenter Content="{Binding GpuLoad}" ContentTemplate="{StaticResource MetricTemplate}" Tag="{loc:Tr Dash_Load}" />
              <ContentPresenter Content="{Binding GpuTemp}" ContentTemplate="{StaticResource MetricTemplate}" Tag="{loc:Tr Dash_Temperature}" />
              <ContentPresenter Content="{Binding GpuPower}" ContentTemplate="{StaticResource MetricTemplate}" Tag="{loc:Tr Dash_Power}" />
              <ContentPresenter Content="{Binding GpuClock}" ContentTemplate="{StaticResource MetricTemplate}" Tag="{loc:Tr Dash_Clock}" />
            </UniformGrid>
          </StackPanel>
        </Border>
        <!-- Memory -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <ui:Icon Kind="Memory" Width="20" Height="20" Foreground="{DynamicResource Brush.Series3}" Margin="0,0,10,0" VerticalAlignment="Center" />
              <TextBlock FontWeight="SemiBold" Text="{loc:Tr Dash_Memory}" VerticalAlignment="Center" />
            </DockPanel>
            <ProgressBar Style="{StaticResource Gauge}" Margin="0,16,0,16" Value="{Binding MemLoad.Value, Mode=OneWay, TargetNullValue=0}"
                         Foreground="{Binding MemLoad.Value, Converter={StaticResource ThresholdBrush}, ConverterParameter='80,92'}" />
            <UniformGrid Columns="2">
              <ContentPresenter Content="{Binding MemLoad}" ContentTemplate="{StaticResource MetricTemplate}" Tag="{loc:Tr Dash_Load}" />
              <ContentPresenter Content="{Binding MemUsed}" ContentTemplate="{StaticResource MetricTemplate}" Tag="{loc:Tr Dash_Used}" />
              <ContentPresenter Content="{Binding MemAvailable}" ContentTemplate="{StaticResource MetricTemplate}" Tag="{loc:Tr Dash_Available}" />
            </UniformGrid>
          </StackPanel>
        </Border>
      </UniformGrid>

      <UniformGrid Columns="2">
        <Border Style="{StaticResource Card}" Height="280">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Section}" Text="{loc:Tr Dash_LoadChart}" />
            <lvc:CartesianChart Series="{Binding LoadSeries}" XAxes="{Binding LoadXAxes}" YAxes="{Binding LoadYAxes}"
                                LegendPosition="Bottom" TooltipPosition="Hidden" AnimationsSpeed="0:0:0" />
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}" Height="280">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Section}" Text="{loc:Tr Dash_TempChart}" />
            <lvc:CartesianChart Series="{Binding TempSeries}" XAxes="{Binding TempXAxes}" YAxes="{Binding TempYAxes}"
                                LegendPosition="Bottom" TooltipPosition="Hidden" AnimationsSpeed="0:0:0" />
          </DockPanel>
        </Border>
      </UniformGrid>

      <UniformGrid Columns="3">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Dash_Storage}" />
            <TextBlock Style="{StaticResource Text.Muted}" Text="{loc:Tr Dash_NoData}"
                       Visibility="{Binding StorageTemps.Count, Converter={x:Static local:ZeroToVisibility.Instance}}" xmlns:local="clr-namespace:NovaHardware.App.Views" />
            <ItemsControl ItemsSource="{Binding StorageTemps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,4">
                    <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding Value}" Foreground="{Binding Raw, Converter={StaticResource ThresholdBrush}, ConverterParameter='50,65'}" />
                    <TextBlock Text="{Binding Device}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Dash_Fans}" />
            <TextBlock Style="{StaticResource Text.Muted}" Text="{loc:Tr Dash_NoData}"
                       Visibility="{Binding Fans.Count, Converter={x:Static local:ZeroToVisibility.Instance}}" xmlns:local="clr-namespace:NovaHardware.App.Views" />
            <ItemsControl ItemsSource="{Binding Fans}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,4">
                    <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding Value}" />
                    <TextBlock TextTrimming="CharacterEllipsis" Margin="0,0,12,0"><Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Device, Mode=OneWay}" Foreground="{DynamicResource Brush.TextMuted}" /></TextBlock>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Dash_Providers}" />
            <ItemsControl ItemsSource="{Binding Providers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,4" ToolTip="{Binding Message}">
                    <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                      <Ellipse.Style>
                        <Style TargetType="Ellipse">
                          <Setter Property="Fill" Value="{DynamicResource Brush.TextMuted}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                              <Setter Property="Fill" Value="{DynamicResource Brush.Good}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Ellipse.Style>
                    </Ellipse>
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                      <TextBlock Style="{StaticResource Text.Muted}" FontSize="11" Text="{Binding Message}" />
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </UniformGrid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
