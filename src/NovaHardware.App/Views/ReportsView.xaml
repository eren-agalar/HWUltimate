<UserControl x:Class="NovaHardware.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NovaHardware.UI.Localization;assembly=NovaHardware.UI"
             xmlns:ui="clr-namespace:NovaHardware.UI.Controls;assembly=NovaHardware.UI">
  <Grid Margin="20,2,20,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition /></Grid.ColumnDefinitions>
    <TextBlock Grid.ColumnSpan="2" Style="{StaticResource Text.PageTitle}" Text="{loc:Tr Nav_Reports}" Margin="0,0,0,12" />

    <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top">
      <StackPanel>
        <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Reports_Format}" />
        <ItemsControl ItemsSource="{Binding Formats}" Margin="0,0,0,12">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <RadioButton Style="{StaticResource Chip}" GroupName="Format" Content="{Binding}" Margin="0,0,6,6"
                           Checked="Format_Checked" Loaded="Format_Loaded" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Reports_Sections}" />
        <ItemsControl ItemsSource="{Binding Sections}">
          <ItemsControl.ItemTemplate>
            <DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsIncluded}" /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Style="{StaticResource Nova.Button.Primary}" Margin="0,16,0,8" HorizontalAlignment="Stretch" Command="{Binding ExportCommand}">
          <StackPanel Orientation="Horizontal"><ui:Icon Kind="Export" Width="14" Height="14" Margin="0,0,7,0" Foreground="{DynamicResource Brush.OnAccent}" /><TextBlock Text="{loc:Tr Reports_Export}" /></StackPanel>
        </Button>
        <Button Margin="0,0,0,6" HorizontalAlignment="Stretch" Content="{loc:Tr Reports_OpenLast}" Command="{Binding OpenLastCommand}" IsEnabled="{Binding LastExport, Converter={x:Static ui:NotNullConverter.Instance}}" />
        <Button HorizontalAlignment="Stretch" Content="{loc:Tr Reports_OpenFolder}" Command="{Binding OpenFolderCommand}" />
        <ProgressBar IsIndeterminate="True" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        <TextBlock Margin="0,12,0,0" Text="{Binding Message}" TextWrapping="Wrap">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Good}" />
              <Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Bad}" /></DataTrigger></Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </Border>

    <!-- Native preview -->
    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="0" Padding="0">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="16,12,12,4">
          <ui:NovaIconButton DockPanel.Dock="Right" Icon="Refresh" Label="{loc:Tr Common_Refresh}" Command="{Binding RefreshCommand}" />
          <TextBlock Style="{StaticResource Text.Section}" Text="{loc:Tr Reports_Preview}" Margin="0" VerticalAlignment="Center" />
        </DockPanel>
        <Grid>
          <TextBlock Style="{StaticResource Text.Muted}" Text="{loc:Tr Reports_NothingSelected}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{Binding PreviewEmpty, Converter={StaticResource BoolToVis}}" />
          <ScrollViewer Padding="16,0,16,16">
            <ItemsControl ItemsSource="{Binding Preview}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,10,0,6">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource Text.Small}" Text="{Binding Subtitle}" Visibility="{Binding Subtitle, Converter={StaticResource NullToVis}}" />
                    <ItemsControl ItemsSource="{Binding Rows}" Margin="0,6,0,0" AlternationCount="2">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border x:Name="Row" Padding="8,4" CornerRadius="5">
                            <Grid>
                              <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition /></Grid.ColumnDefinitions>
                              <TextBlock Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,12,0" />
                              <StackPanel Grid.Column="1">
                                <TextBlock x:Name="Value" Text="{Binding Value}" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Text.Small}" Text="{Binding Detail}" Visibility="{Binding Detail, Converter={StaticResource NullToVis}}" />
                              </StackPanel>
                            </Grid>
                          </Border>
                          <DataTemplate.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.RowAlt}" /></Trigger>
                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                              <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                              <Setter TargetName="Value" Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
