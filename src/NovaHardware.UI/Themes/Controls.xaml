<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:NovaHardware.UI.Controls">

  <!-- ===================================================================== tokens (defaults; ThemeManager overwrites) -->
  <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
  <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <CornerRadius x:Key="Radius.Control">7</CornerRadius>
  <CornerRadius x:Key="Radius.Card">10</CornerRadius>

  <!-- ===================================================================== typography -->
  <Style x:Key="Text.PageTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
    <Setter Property="FontSize" Value="{DynamicResource Size.FontTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style x:Key="Text.Section" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource Size.FontSmall}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style x:Key="Text.Muted" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Text.Small" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
    <Setter Property="FontSize" Value="{DynamicResource Size.FontSmall}" />
  </Style>
  <Style x:Key="Text.Metric" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style x:Key="Cell.Numeric" TargetType="TextBlock">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Margin" Value="0,0,12,12" />
  </Style>
  <Style x:Key="Popup.Card" TargetType="Border" BasedOn="{StaticResource Card}">
    <Setter Property="Margin" Value="6" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.28" Color="{DynamicResource Color.Shadow}" />
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================== NovaButton -->
  <Style x:Key="Nova.Button" TargetType="ButtonBase">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="{DynamicResource Thickness.Control}" />
    <Setter Property="MinHeight" Value="{DynamicResource Size.Control}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PanelHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selection}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource Nova.Button}" />
  <Style x:Key="Nova.Button.Primary" TargetType="Button" BasedOn="{StaticResource Nova.Button}">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.9" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Nova.Button.Danger" TargetType="Button" BasedOn="{StaticResource Nova.Button}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Bad}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Bad}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Nova.Button.Ghost" TargetType="ButtonBase" BasedOn="{StaticResource Nova.Button}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style x:Key="Nova.Button.Chrome" TargetType="Button">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PanelHover}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================== NovaIconButton -->
  <Style TargetType="ui:NovaIconButton" BasedOn="{StaticResource Nova.Button}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="Padding" Value="7,5" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ui:NovaIconButton">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}" MinHeight="{DynamicResource Size.Control}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
              <ui:Icon Kind="{TemplateBinding Icon}" Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}" Foreground="{TemplateBinding Foreground}" />
              <TextBlock x:Name="LabelText" Text="{TemplateBinding Label}" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Label" Value="{x:Null}"><Setter TargetName="LabelText" Property="Visibility" Value="Collapsed" /></Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PanelHover}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selection}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Nova.IconButton.Bordered" TargetType="ui:NovaIconButton" BasedOn="{StaticResource {x:Type ui:NovaIconButton}}">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Padding" Value="{DynamicResource Thickness.Control}" />
  </Style>

  <!-- ===================================================================== toggle buttons / chips -->
  <Style x:Key="Nova.ToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource Nova.Button}">
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Chip" TargetType="RadioButton" BasedOn="{StaticResource Nova.Button}">
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="Padding" Value="11,4" />
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <!-- Segmented control: two or more chips in a row (Compact / Advanced, etc.) -->
  <Style x:Key="Segment" TargetType="RadioButton" BasedOn="{StaticResource Chip}">
    <Setter Property="Margin" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- ===================================================================== NovaToggle (switch) -->
  <Style x:Key="NovaToggle" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Margin" Value="0,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <DockPanel Background="Transparent">
            <Grid DockPanel.Dock="Right" Width="36" Height="20" Margin="12,0,0,0" VerticalAlignment="Center">
              <Border x:Name="Track" CornerRadius="10" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" />
              <Ellipse x:Name="Knob" Width="14" Height="14" Margin="3,0" HorizontalAlignment="Left" Fill="{DynamicResource Brush.TextMuted}" />
            </Grid>
            <ContentPresenter VerticalAlignment="Center" />
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Brush.OnAccent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="NovaSwitch" TargetType="CheckBox" BasedOn="{StaticResource NovaToggle}" />

  <!-- ===================================================================== NovaCheckbox -->
  <Style x:Key="NovaCheckbox" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Margin" Value="0,3" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" VerticalAlignment="Center"
                    Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
              <Path x:Name="Check" Data="M3,8 L6.5,11.5 L13,4.5" Stroke="{DynamicResource Brush.OnAccent}" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" Margin="0,0,0,0" />
            </Border>
            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource NovaCheckbox}" />

  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Margin" Value="0,3" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid Width="16" Height="16" VerticalAlignment="Center">
              <Ellipse x:Name="Ring" Fill="{DynamicResource Brush.Surface}" Stroke="{DynamicResource Brush.Line}" StrokeThickness="1" />
              <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
            </Grid>
            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.Accent}" />
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.Accent}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================== text inputs -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinHeight" Value="{DynamicResource Size.Control}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.TextMuted}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Read-only selectable value text inside tables -->
  <Style x:Key="Text.Selectable" TargetType="TextBox">
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" /></ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- NovaSearchBox -->
  <Style TargetType="ui:NovaSearchBox">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="MinHeight" Value="{DynamicResource Size.Control}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ui:NovaSearchBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}">
            <DockPanel>
              <ui:Icon DockPanel.Dock="Left" Kind="Search" Width="14" Height="14" Margin="9,0,4,0" Foreground="{DynamicResource Brush.TextMuted}" />
              <Button x:Name="ClearButton" DockPanel.Dock="Right" Command="{x:Static ui:NovaSearchBox.ClearCommand}" Focusable="False" Cursor="Hand"
                      Visibility="Collapsed" Margin="0,0,6,0" Width="18" Height="18" ToolTip="Clear">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="Transparent"><ui:Icon Kind="Close" Width="10" Height="10" Foreground="{DynamicResource Brush.TextMuted}" /></Border>
                  </ControlTemplate>
                </Button.Template>
              </Button>
              <Grid>
                <TextBlock x:Name="PlaceholderText" Text="{TemplateBinding Placeholder}" Margin="2,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False" Visibility="Collapsed" />
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
              </Grid>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value=""><Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" /></Trigger>
            <DataTrigger Binding="{Binding Text.Length, RelativeSource={RelativeSource Self}, Converter={x:Static ui:NonZeroConverter.Instance}}" Value="True">
              <Setter TargetName="ClearButton" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.TextMuted}" /></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================== NovaDropdown (ComboBox) -->
  <Style x:Key="Nova.ComboBoxToggle" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ClickMode" Value="Press" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}">
            <ui:Icon x:Name="Arrow" Kind="ChevronDown" Width="11" Height="11" HorizontalAlignment="Right" Margin="0,0,9,0" Foreground="{DynamicResource Brush.TextMuted}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.TextMuted}" /></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
              <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="NovaDropdown" TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="MinHeight" Value="{DynamicResource Size.Control}" />
    <Setter Property="MinWidth" Value="140" />
    <Setter Property="Padding" Value="10,0,30,0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Style="{StaticResource Nova.ComboBoxToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" TextElement.Foreground="{TemplateBinding Foreground}" />
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border Style="{StaticResource Popup.Card}" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4,6,6">
                <ScrollViewer SnapsToDevicePixels="True">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource NovaDropdown}" />
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PanelHover}" /></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================== NovaSlider -->
  <Style x:Key="Nova.SliderThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Ellipse x:Name="E" Width="14" Height="14" Fill="{DynamicResource Brush.Text}" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="2" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="E" Property="Fill" Value="{DynamicResource Brush.Accent}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Nova.SliderRepeat" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="NovaSlider" TargetType="Slider">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid VerticalAlignment="Center">
            <Border Height="4" CornerRadius="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" />
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource Nova.SliderRepeat}">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{DynamicResource Brush.Accent}" /></ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource Nova.SliderRepeat}" /></Track.IncreaseRepeatButton>
              <Track.Thumb><Thumb Style="{StaticResource Nova.SliderThumb}" /></Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Slider" BasedOn="{StaticResource NovaSlider}" />

  <!-- ===================================================================== scroll bars -->
  <Style x:Key="Nova.ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="B" CornerRadius="4" Background="{DynamicResource Brush.Line}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Brush.TextMuted}" /></Trigger>
            <Trigger Property="IsDragging" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Brush.TextMuted}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent" Margin="2">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource Nova.SliderRepeat}" /></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource Nova.SliderRepeat}" /></Track.IncreaseRepeatButton>
              <Track.Thumb><Thumb Style="{StaticResource Nova.ScrollThumb}" /></Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="Transparent" Margin="2">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource Nova.SliderRepeat}" /></Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource Nova.SliderRepeat}" /></Track.IncreaseRepeatButton>
                  <Track.Thumb><Thumb Style="{StaticResource Nova.ScrollThumb}" /></Track.Thumb>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="ScrollViewer">
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
  </Style>

  <!-- ===================================================================== menus -->
  <Style TargetType="ContextMenu">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Style="{StaticResource Popup.Card}" MinWidth="180">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="10,6">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{TemplateBinding InputGestureText}" Margin="24,0,0,0" Foreground="{DynamicResource Brush.TextMuted}" />
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PanelHover}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator"><Border Height="1" Margin="6,4" Background="{DynamicResource Brush.Line}" /></ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================== NovaTooltip -->
  <Style x:Key="NovaTooltip" TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="6" Padding="9,5" Margin="4" MaxWidth="420">
            <ContentPresenter TextElement.FontSize="{DynamicResource Size.FontSmall}">
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ToolTip" BasedOn="{StaticResource NovaTooltip}" />

  <!-- ===================================================================== NovaStatusIndicator -->
  <Style TargetType="ui:NovaStatusIndicator">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ui:NovaStatusIndicator">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
            <TextBlock x:Name="Label" Text="{TemplateBinding Text}" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" FontSize="{DynamicResource Size.FontSmall}" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="{x:Null}"><Setter TargetName="Label" Property="Visibility" Value="Collapsed" /></Trigger>
            <Trigger Property="Status" Value="Normal"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Good}" /></Trigger>
            <Trigger Property="Status" Value="Warning"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Warn}" /></Trigger>
            <Trigger Property="Status" Value="Critical"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Bad}" /></Trigger>
            <Trigger Property="Status" Value="Info"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Info}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================== NovaNavigation -->
  <Style x:Key="NovaNavigation" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="Margin" Value="8,1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border x:Name="Bd" CornerRadius="{StaticResource Radius.Control}" Background="Transparent" Padding="12,8">
              <ContentPresenter />
            </Border>
            <Border x:Name="Bar" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="0,9" Background="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PanelHover}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PanelHover}" /></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selection}" />
              <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================== list boxes (shared item chrome) -->
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style x:Key="Nova.ListItem" TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Padding="8,6" CornerRadius="{StaticResource Radius.Control}" Background="Transparent"><ContentPresenter /></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PanelHover}" /></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selection}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Nova.TabItem" TargetType="ListBoxItem">
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Padding="12,5" CornerRadius="{StaticResource Radius.Control}" Background="Transparent">
            <ContentPresenter TextElement.Foreground="{DynamicResource Brush.TextMuted}" x:Name="Cp" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PanelHover}" /></Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selection}" />
              <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource Brush.Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================== NovaDataGrid -->
  <Style x:Key="NovaDataGrid" TargetType="DataGrid">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="RowBackground" Value="Transparent" />
    <Setter Property="AlternatingRowBackground" Value="{DynamicResource Brush.RowAlt}" />
    <Setter Property="AlternationCount" Value="2" />
    <Setter Property="GridLinesVisibility" Value="None" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="CanUserDeleteRows" Value="False" />
    <Setter Property="CanUserResizeRows" Value="False" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="RowHeight" Value="{DynamicResource Size.Control}" />
    <Setter Property="EnableRowVirtualization" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
  </Style>
  <Style TargetType="DataGrid" BasedOn="{StaticResource NovaDataGrid}" />
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="{DynamicResource Size.FontSmall}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="DataGridCell">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" /></Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Selection}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="DataGridRow">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.PanelHover}" /></Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===================================================================== progress -->
  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
</ResourceDictionary>
